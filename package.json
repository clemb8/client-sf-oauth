{
  "name": "client-sf-oauth",
  "version": "0.7.1",
  "description": "Get a Salesforce access token from Node.js with OAuth 2.0 — JWT bearer, web-server (authorization code) with PKCE, or username-password — in TypeScript with typed parameters.",
  "keywords": [
    "salesforce",
    "salesforce-api",
    "sfdc",
    "oauth",
    "oauth2",
    "jwt",
    "jwt-bearer",
    "pkce",
    "authorization-code",
    "web-server-flow",
    "connected-app",
    "access-token",
    "typescript",
    "nodejs"
  ],
  "homepage": "https://github.com/clemb8/client-sf-oauth#readme",
  "bugs": {
    "url": "https://github.com/clemb8/client-sf-oauth/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clemb8/client-sf-oauth.git"
  },
  "license": "MIT",
  "author": "clemb8",
  "main": "dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "prebuild": "eslint src",
    "build": "tsc",
    "lint": "eslint src",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json",
    "version": "git add CHANGELOG.md",
    "postversion": "echo 'Tagged locally. Review, then push: git push && git push --tags'"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
