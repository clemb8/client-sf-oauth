# client-sf-oauth — E2E test credentials
#
# Copy to `.env` and fill in. `.env` is gitignored; never commit it.
#
# Every suite skips itself when its variables are absent, so you can fill in
# one flow at a time and run just that one. Setup instructions for the org
# side are in e2e/README.md.

# ---------------------------------------------------------------------------
# JWT Bearer flow  —  e2e/jwt.e2e.test.ts
# ---------------------------------------------------------------------------
# Connected App with "Use digital signatures" and a certificate uploaded.
# The running user must be pre-authorized on the app.

SF_JWT_CLIENT_ID=                 # Consumer Key of the Connected App
SF_JWT_USERNAME=                  # Salesforce username the token is issued for
SF_JWT_KEY_PATH=                  # Absolute path to the PEM private key. Keep it OUTSIDE this repo.
SF_JWT_PASSPHRASE=                # Optional — only if the key is passphrase-encrypted
SF_JWT_ENVIRONMENT=               # Optional — set to `dev` for a sandbox (test.salesforce.com). Leave empty for a Developer Edition org.

# ---------------------------------------------------------------------------
# Username-Password flow  —  e2e/password.e2e.test.ts  —  DEPRECATED
# ---------------------------------------------------------------------------
# Salesforce is retiring this grant. It is disabled by default on new orgs and
# on many orgs the enabling setting no longer exists at all.
#
# This suite is SKIPPED by default. Set SF_PASS_RUN_DEPRECATED=1 to run it
# against an org that still permits the flow. Its security coverage lives in
# the unit suite, which needs no org and runs on every `npm test`.

SF_PASS_RUN_DEPRECATED=           # Set to 1 to run the deprecated flow's E2E tests

SF_PASS_CLIENT_ID=                # Consumer Key
SF_PASS_CLIENT_SECRET=            # Consumer Secret
SF_PASS_USERNAME=                 # Salesforce username
SF_PASS_PASSWORD=                 # Salesforce password (password only — the token goes below)
SF_PASS_USERTOKEN=                # Optional — security token. Omit if your login IP range is relaxed.
SF_PASS_HOST=https://login.salesforce.com/   # Trailing slash optional; both are tested

# ---------------------------------------------------------------------------
# Web Server / authorization code flow  —  e2e/webapp.e2e.test.ts
# ---------------------------------------------------------------------------
# The redirect URI must match the Connected App's callback URL exactly.

SF_WEB_CLIENT_ID=                 # Consumer Key
SF_WEB_CLIENT_SECRET=             # Consumer Secret
SF_WEB_HOST=https://login.salesforce.com
SF_WEB_REDIRECT_URI=              # e.g. http://localhost:3000/oauth/callback

# Optional, single-use. Paste a real authorization code here to unskip the
# full round-trip test. Codes expire in ~15 minutes and work exactly once.
# The code is bound to the PKCE verifier of the authorize request that minted
# it, so paste that verifier too — e2e/README.md shows how to obtain both.
SF_WEB_AUTH_CODE=
SF_WEB_CODE_VERIFIER=
